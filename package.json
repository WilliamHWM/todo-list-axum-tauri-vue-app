    "element-plus": "^2.14.3",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
