{
  "name": "axum-tauri-vue-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
